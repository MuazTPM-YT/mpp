import llm, io
print(llm.exact_match("  The ANSWER.", "answer"), llm.exact_match("x y", "y x"), llm.exact_match(["x", "y"], ["x", "z"]))
print(llm.token_f1("new york city", "york city"), llm.similarity("kitten", "sitting"), llm.edit_distance("flaw", "lawn"))
print(llm.contains("Hello World", "world"), llm.contains("Hello", "world"), llm.regex_match("order #123", r"#\d+"))
print(llm.extract("total: 42 items", r"total: (\d+)"), llm.extract_all("a1 b22 c333", r"\d+"))
print(llm.json_valid("{\"a\": 1}"), llm.json_valid("{a: 1}"), llm.parse_json("Here: ```json\n[1, 2]\n```"))
s = llm.json_schema("{\"age\": -3, \"tags\": [\"x\", 2]}", {"type": "object", "required": ["name"], "properties": {"age": {"type": "integer", "minimum": 0}, "tags": {"type": "array", "items": {"type": "string"}}}})
print(s.valid, s.errors)
print(round(llm.bleu("the cat sat on the mat", "the cat is on the mat", smooth = true), 4), llm.rouge("a b c d", "a b x d"))
print(round(llm.chrf("hello world", ["hello word"]), 3), llm.rouge_n("a b c", "a b d", n = 2))
print(llm.refusal("I'm sorry, but I cannot do that."), llm.refusal("Sure, here it is."))
print(llm.pass_at_k(5, 0, 1), llm.pass_at_k(5, 5, 1), round(llm.pass_at_k(20, 4, 5), 4))
print(llm.latency_stats([10, 20, 30, 40, 1000]))
print(round(llm.perplexity_of([-1.0, -1.0]), 6))
io.write("tests/cases/data/tmp_log.csv", "step,loss,val_loss,lr\n1,2.0,,0.001\n2,1.8,1.9,0.001\n3,nan,,0.001\n4,1.5,1.7,0.0005\n")
c = llm.check_training("tests/cases/data/tmp_log.csv")
print(c.healthy, c.problems, c.summary.final_loss)
io.remove("tests/cases/data/tmp_log.csv")
t = table({"step": [1, 2, 3, 4], "loss": [3.0, 2.0, 1.5, 1.4]})
print(llm.check_training(t).healthy, plot(t, "step", "loss"))
