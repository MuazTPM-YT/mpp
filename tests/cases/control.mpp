for i in 0..3 { print("range", i) }
for i in 1..=3 { print("incl", i) }
for ch in "ab" { print("char", ch) }
for k in {"x": 1, "y": 2} { print("key", k) }
n = 0
while n < 5 {
    n += 1
    if n == 2 { continue }
    if n == 4 { break }
    print("while", n)
}
grade = 85
if grade >= 90 { print("A") }
elif grade >= 80 { print("B") }
else { print("C") }
if grade < 50 {
    print("fail")
} else {
    print("pass")
}
found = nil
for row in [[1, 2], [3, 4]] {
    for v in row {
        if v == 3 {
            found = v
            break
        }
    }
}
print("found", found)
# break out of try inside loop
for i in 0..5 {
    try {
        if i == 2 { break }
        print("try", i)
    } catch e { print("never") }
}
try { throw "after loop" } catch e { print("handler still ok:", e.message) }
print(range(0, 10, 3), range(5, 0, -2), list(0..4), 5 in 0..10, 10 in 0..10, 3 not in [1, 2])
print(grade > 50 ? "high" : "low")
