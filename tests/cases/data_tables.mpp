t = load_csv("tests/cases/data/small.csv")
print(t)
print(t.columns, t.nrows, len(t), t.ncols)
print(t.score, t.col("name"), t["team"][0])
print(t[0], t.row(-1).name)
print(t.where("team", "==", "red").col("name"))
print(t.filter(r => r.score != nil and r.score > 80).col("name"))
print(t[t.hours > 8].col("name"))
print(t.sort("score", reverse = true).col("name"))
print(t.sort(["team", "name"]).col("name"))
print(t.select("name", "score").columns, t.drop("hours").columns, t.rename({"score": "pts"}).columns)
g = t.group_by("team", {"n": "count()", "avg": "mean(score)", "top": "max(score)", "hours": "sum(hours)", "first": "first(name)"})
print(g)
print(t.value_counts("team"), t.unique("team"))
print(t.dropna().nrows, t.dropna("score").nrows)
t2 = t.with_col("bonus", r => r.active ? 5 : 0).with_col("const", 1)
print(t2.bonus, t2.const)
teams = table({"team": ["red", "blue"], "coach": ["zed", "yan"]})
j = t.join(teams, "team")
print(j.columns, j.nrows, j.col("coach"))
print(t.join(teams, "team", how = "left").col("coach"))
gs = t.groups("team")
print(gs.keys(), gs.red.nrows)
print(t.head(2).nrows, t.tail(2).col("id"), t[1:3].col("id"))
d = t.describe()
print(d.col("column"), d.col("count"))
rows = table([{"a": 1, "b": "x"}, {"a": 2.5}])
print(rows)
for r in t.head(2) { print(r.name, r.score) }
print(t.concat(t).nrows)
