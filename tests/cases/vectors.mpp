v = vec([3, 1, 4, 1, 5, 9, 2, 6])
print(v, len(v), v.sum(), v.mean(), v.median(), v.min(), v.max())
print(v.var(), v.std(), v.std(ddof = 0), v.quantile(0.25), v.quantile([0.1, 0.9]))
w = v * 2 + 1
print(w, w - v, v / 2, 10 - v, v ** 2, -v * 1)
print(v > 3, v[v > 3], v[0], v[-1], v[2:4], v[[0, 2]])
print(v.sorted(), v.sorted(reverse = true), v.rank(), v.cumsum(), v.diff())
print(v.unique(), v.argmax(), v.argmin(), v.between(2, 5), v.eq(1).count())
print(v.dot(v), v.corr(v * 3), v.head(3), v.tail(2))
print(vec([1, nil, 3]).dropna(), vec([1, nil]).isnan(), v.map(x => x * x), v.filter(x => x > 4))
print(v.describe())
print(v.histogram(3))
print(linspace(0, 1, 5), vec([1, 2]) == vec([1, 2]), vec([1, 2]) == vec([2, 1]))
s = 0
for x in vec([1, 2, 3]) { s += x }
print(s, list(vec([1, 2])), 2.0 in vec([1, 2]))
try { vec([1, 2]) + vec([1]) } catch e { print(e.message) }
