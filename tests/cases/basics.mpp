# numbers, strings, truthiness
print(1 + 2 * 3, (1 + 2) * 3, 7 / 2, 7 // 2, -7 // 2, 7 % 3, -7 % 3, 2 ** 10, 2 ** -1)
print(1 == 1.0, 0.1 + 0.2 == 0.3, 0.1 + 0.2 ~= 0.3, 3 > 2, "a" < "b", [1, 2] < [1, 3])
print(1e20, 1.5e-7, 100.0, 0.1, -0.0, 1 / 3)
print("con" + "cat", "ab" * 3, len("héllo"), "héllo"[1], "abcdef"[1:4], "abcdef"[-2:])
print(not 0, not "", not [], bool([0]), nil or "default", 0 and "never", 5 and "yes")
x = 3.14159
name = "mpp"
print(f"{name:>6}|{x:.2f}|{x:8.3f}|{0.256:.1%}|{1234567:,}|{255:x}|{42:05d}|{x:e}")
print(f"nested {[1, 2][0]} {{literal}} {'q'} {name.upper()}")
print("""multi
line""")
print(r"raw\n", "tab\tend", "\u{1F600}")
print(int("42") + 1, int(3.9), int("-7"), float("2.5"), str(12) + "!", round(2.5), round(3.5), round(3.14159, 2))
print(type(1), type(1.0), type("s"), type([]), type({}), type(nil), type(print), type(0..3))
print(min(3, 1, 2), max([4, 9, 2]), abs(-3), abs(-2.5), sum([1, 2, 3]), sum([0.1] * 10))
print(1_000_000, 0xff, 0b101, 0o17)
