# Debug a training run from its log (JSONL or CSV, as written by most trainers).
# run:   mpp run examples/train_debug.mpp
# test:  mpp test examples/train_debug.mpp --report html:train_report.html
import llm

a = llm.train_log("examples/data/train_run_a.jsonl")
b = llm.train_log("examples/data/train_run_b.jsonl")
print(a)

health = a.check()
print(health.issues)
print(health.summary)

crash = b.check()
print("run b healthy:", crash.healthy, crash.problems)

print(a.compare(b))

experiment "run A is healthy enough to keep" {
    report "summary": health.summary
    report "loss curve": a.plot(["loss", "val_loss"])
    report "learning rate": a.plot("lr")
    expect health.healthy
    expect "overfitting" in health.problems      # we know: val loss turns up near the end
}

test "run B blew up and we catch it" {
    expect not crash.healthy
    expect "nan_loss" in crash.problems
}
